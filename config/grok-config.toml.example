# Snippet for ~/.grok/config.toml, same as the Grok configured on the reference PC.
# Merge it with what is already there; do not replace the whole file.

[ui]
# "auto" asks for confirmation only for risky actions. Use "default" to confirm everything.
permission_mode = "auto"
yolo = false
compact_mode = false
max_thoughts_width = 120
fork_secondary_model = "grok-4.6"

[models]
default = "grok-4.6"
default_reasoning_effort = "xhigh"   # "high" saves tokens if Grok is only a worker

# The rules in ~/.grok/rules/*.md already load in every project, no setup needed.
# If you want to keep the team rules in another folder:
# [paths]
# extra_rule_dirs = ["~/orca-skills/config"]
